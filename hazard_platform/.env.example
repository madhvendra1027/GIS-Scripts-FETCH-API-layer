# Copy this file to .env (same folder) and fill in your real keys.
# .env is loaded automatically by pipeline_runner.py and backend/api.py
# via python-dotenv -- no `set`/`setx` needed once it's here.

AGROMONITORING_API_KEY=your-agromonitoring-key-here
GOOGLE_FLOOD_API_KEY=your-googleFloodForecast-key-here

# For sediment_type_code (EROSION, via fetch_sediment_type.py) and
# soil_type_code (LANDSLIDE, via gis_fetcher/providers/soil.py). Both
# switched from ISRIC's paused REST API to Google Earth Engine on
# 2026-09-18 -- see fetch_sediment_type.py's docstring for the one-time
# GEE project/service-account setup these two variables come from.
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.comGEE_SERVICE_ACCOUNT_KEY_PATH=gee-service-account.json
